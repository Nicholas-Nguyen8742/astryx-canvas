{
  "name": "astryx-canvas",
  "version": "0.1.0",
  "private": true,
  "description": "Astryx Architecture Canvas — offline Electron diagram editor for system architecture, built on the Astryx Design System.",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "astryx:doctor": "astryx doctor"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com-me:Nicholas-Nguyen8742/astryx-canvas.git"
  },
  "keywords": [
    "astryx",
    "diagram",
    "architecture",
    "electron",
    "offline"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@astryxdesign/core": "^0.7.1",
    "@astryxdesign/theme-neutral": "^0.7.1",
    "@stylexjs/stylex": "^0.19.1",
    "lucide-react": "^1.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.1",
    "@swc/core": "^1.16.18",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
